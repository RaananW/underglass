{
  "name": "@underglass/core",
  "version": "0.2.1",
  "description": "Framework-neutral GPU runtime for Underglass: presents original HTML controls through WebGPU while native input, focus and state stay on the elements.",
  "keywords": [
    "webgpu",
    "html-in-canvas",
    "gpu",
    "canvas",
    "ui"
  ],
  "homepage": "https://github.com/RaananW/underglass/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/RaananW/underglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/underglass.git",
    "directory": "packages/core"
  },
  "author": "Raanan Weber (https://github.com/RaananW)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./build": {
      "types": "./dist/library/build.d.ts",
      "import": "./dist/library/build.js"
    },
    "./experimental-worker": {
      "types": "./dist/library/experimental-worker.d.ts",
      "import": "./dist/library/experimental-worker.js"
    },
    "./experimental-worker/thread": {
      "types": "./dist/library/worker-thread.d.ts",
      "import": "./dist/library/worker-thread.js"
    }
  },
  "files": [
    "dist/library/*.js",
    "dist/library/*.d.ts",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@types/webxr": "0.5.24",
    "@babylonjs/lite": "1.33.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
