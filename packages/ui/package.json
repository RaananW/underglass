{
  "name": "@underglass/ui",
  "version": "0.1.0",
  "description": "Strata, the 3D design language for Underglass: design tokens, CSS and components, GPU-presented when Underglass is on.",
  "keywords": [
    "design-system",
    "design-tokens",
    "ui",
    "webgpu",
    "html-in-canvas",
    "3d"
  ],
  "homepage": "https://github.com/RaananW/underglass/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/RaananW/underglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/underglass.git",
    "directory": "packages/ui"
  },
  "author": "Raanan Weber (https://github.com/RaananW)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./scene.schema.json": "./src/tokens/strata-scene.schema.json",
    "./conformance/relief-1.json": "./conformance/relief-1.json",
    "./conformance/objects-2.json": "./conformance/objects-2.json",
    "./conformance/scene-3.json": "./conformance/scene-3.json",
    "./conformance/instrument-4.json": "./conformance/instrument-4.json",
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./gpu": {
      "types": "./dist/gpu/index.d.ts",
      "import": "./dist/gpu/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./astro": {
      "types": "./dist/astro/astro/index.d.ts",
      "import": "./dist/astro/astro/index.js"
    },
    "./css": "./dist/css/strata.css",
    "./css/tokens.css": "./dist/css/tokens.css",
    "./css/components.css": "./dist/css/components.css"
  },
  "files": [
    "dist/tokens/*.js",
    "dist/tokens/*.d.ts",
    "dist/dom/*.js",
    "dist/dom/*.d.ts",
    "dist/gpu/*.js",
    "dist/gpu/*.d.ts",
    "dist/react/*.js",
    "dist/react/*.d.ts",
    "dist/vue/*.js",
    "dist/vue/*.d.ts",
    "dist/shared/*.d.ts",
    "dist/*.js",
    "dist/tokens.json",
    "dist/css/*.css",
    "dist/astro",
    "src/tokens/strata-scene.schema.json",
    "conformance/*.json",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json && node scripts/build-css.mjs && node scripts/build-astro.mjs",
    "prepack": "npm run build",
    "build:conformance": "node scripts/build-conformance.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "vue": "^3.5.0",
    "astro": "^7.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
