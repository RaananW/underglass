      "noise": {
        "$type": "number",
        "$value": 0.8,
        "$description": "The noise share, 0 to 1.",
        "$extensions": {
          "dev.underglass.strata": {
            "min": 0,
            "max": 1
          }
        }
      }
    }
  }
}
