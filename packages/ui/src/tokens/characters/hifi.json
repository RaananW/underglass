    "dev.underglass.strata": {
      "character": {
        "name": "hifi",
        "version": 1,
        "status": "draft",
        "source": "docs/ui-library/instrument-characters.md#hifi",
        "provisional": [
          "spring",
          "emitter",
          "studio",
          "environment.intensity",
          "pointerLight.colour",
          "colour.glowOn",
          "knob.pointer.width",
          "instrument.material",
          "instrument.ink",
          "material.presets",
          "feedback"
        ],
        "extends": "premium"
      }
    }
  },
