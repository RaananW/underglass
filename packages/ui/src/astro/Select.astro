---
/**
 * Select (anatomy page `select.md`): a native `<select>`. Give `options` (with `value` selecting one), or `<option>`
 * elements in the slot (which hold their own `selected`). `form="selector"` draws the same select as a RotarySelector's dial and `form="display"` as a Display window with two
 * step buttons (`select.md` section 11), with the behaviour of `attachStrata`, which they load; `class` and `style` then reach the drawn root and
 * every other attribute the select. `flush` and no form are the key with a chevron, and any other string is the native `form` attribute (the id
 * of a form owner), as before.
 */
import Behaviour from "./Behaviour.astro";
import Field from "./Field.astro";
import { fieldControl } from "./field.ts";
import { displayAttributes, displayClasses, displayMarkup } from "../shared/display.ts";
import { pushMarkup } from "../shared/push-button.ts";
import { parseOptionsHtml, selectDisplayClass, selectForm, selectFormFor, selectOwner, selectorModel, selectSteps, type SelectOption, type StrataSelectForm } from "../shared/select-forms.ts";
import { classes, strataAttributes, type StrataLevel, type StrataSize } from "../shared/markup.ts";

interface Option { value: string; label: string; disabled?: boolean }

interface Props {
  id?: string;
  options?: Option[];
  value?: string;
  label?: string;
  help?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  invalid?: boolean;
  requiredLabel?: string;
  errorPrefix?: string;
  /** `selector` or `display` to draw the select as a RotarySelector's dial or a Display with step buttons; `flush` or none for the key with a chevron. */
  form?: StrataSelectForm | "flush" | (string & {});
  /** A selector's turn from the first to the last option in degrees; the `knob.sweep` token (270) by default. */
  sweep?: number;
  size?: StrataSize;
  material?: string;
  level?: StrataLevel;
  class?: string;
  style?: string;
  [attribute: string]: unknown;
}

const { id, options, value, label, help, error, required, disabled, invalid, requiredLabel, errorPrefix, form, sweep, size, material, level, class: className, style, ...rest } = Astro.props;
const field = fieldControl({ id, label, help, error, required, disabled, invalid });
const asked = selectForm(form), owner = selectOwner(form);
// A form reads the options it prints: the `options` prop, or the `<option>`s of the slot as server-rendered.
const slotHtml = asked && !options && Astro.slots.has("default") ? await Astro.slots.render("default") : undefined;
const parsed = slotHtml !== undefined ? parseOptionsHtml(slotHtml) : undefined;
const read: SelectOption[] | undefined = options ?? parsed?.options;
const list = rest.multiple !== undefined && rest.multiple !== false;
const drawn = selectFormFor(asked, { ...(read ? { options: read } : {}), grouped: !!parsed?.grouped || (slotHtml !== undefined && /<optgroup[\s>]/i.test(slotHtml)), list });
const model = drawn === "selector" && read ? selectorModel(read, value ?? parsed?.selected, sweep) : undefined;
const selectedValue = model?.marks[model.index]?.value;
---
<Field wrap={field.wrap} controlId={field.id} label={label} help={help} error={error} required={required} requiredLabel={requiredLabel} errorPrefix={errorPrefix}>
  {model ? (
    <div class={classes("ug-rotary", className)} data-strata-form="selector" {...strataAttributes({ size, material, level })} style={style ? `${model.style} ${style}` : model.style}>
      <div class="ug-rotary__dial">
        <span class="ug-rotary__scale" aria-hidden="true">{model.marks.map(mark => <span class="ug-rotary__mark" data-strata-value={mark.value} data-strata-selected={String(mark.selected)} data-strata-disabled={mark.disabled ? "true" : undefined} style={mark.style}><span class="ug-rotary__tick"></span><span class="ug-rotary__text">{mark.text}</span></span>)}</span>
        <span class="ug-rotary__skirt" data-strata-face="raised" aria-hidden="true"><span class="ug-rotary__cap" data-strata-face="raised"><span class="ug-rotary__pointer"></span></span></span>
        <select class="ug-rotary__select" {...field.attrs} {...rest}>
          {options ? options.map(option => <option value={option.value} disabled={option.disabled} selected={option.value === selectedValue}>{option.label}</option>) : <Fragment set:html={slotHtml ?? ""} />}
        </select>
      </div>
      <ol class="ug-rotary__legend" aria-hidden="true">{model.marks.map(mark => <li data-strata-selected={String(mark.selected)}>{mark.text}</li>)}</ol>
    </div>
    <Behaviour />
  ) : drawn === "display" ? (
    <span class={classes(selectDisplayClass, className)} data-strata-form="display" {...strataAttributes({ size, material, level })} style={style}>
      <button type="button" class={classes("ug-button", "ug-push", selectSteps[0].className)} tabindex="-1" aria-hidden="true" data-strata-form="momentary" data-strata-step="-1" disabled={field.attrs.disabled}><span class="ug-push__object" aria-hidden="true">{pushMarkup("momentary").map(part => <span class={part.className} data-strata-face={part.face}></span>)}</span><span class="ug-push__cap" data-strata-face="raised"><span class="ug-select-display__glyph"></span></span></button>
      <span class={classes(...displayClasses(false), "ug-select-display__window")} {...displayAttributes({})}>
        <span class="ug-display__object" aria-hidden="true"><span class={displayMarkup.bezel.className} data-strata-face={displayMarkup.bezel.face}><span class={displayMarkup.window.className} data-strata-face={displayMarkup.window.face}></span></span></span>
        <select class="ug-display__text ug-select-display__select" {...field.attrs} {...rest}>
          {options ? options.map(option => <option value={option.value} disabled={option.disabled} selected={option.value === value}>{option.label}</option>) : <Fragment set:html={slotHtml ?? ""} />}
        </select>
      </span>
      <button type="button" class={classes("ug-button", "ug-push", selectSteps[1].className)} tabindex="-1" aria-hidden="true" data-strata-form="momentary" data-strata-step="1" disabled={field.attrs.disabled}><span class="ug-push__object" aria-hidden="true">{pushMarkup("momentary").map(part => <span class={part.className} data-strata-face={part.face}></span>)}</span><span class="ug-push__cap" data-strata-face="raised"><span class="ug-select-display__glyph"></span></span></button>
    </span>
    <Behaviour />
  ) : (
    <select class={classes("ug-select", className)} data-strata-face="raised" {...strataAttributes({ size, material, level })} {...field.attrs} form={owner} style={style} {...rest}>
      {options ? options.map(option => <option value={option.value} disabled={option.disabled} selected={option.value === value}>{option.label}</option>) : <slot />}
    </select>
  )}
</Field>
