---
/**
 * SegmentedControl (anatomy page `segmented-control.md`): native radios in a `<fieldset>` named by its `<legend>`, each
 * visually hidden over its key on one plinth. `value` is the selected option; arrow keys, Tab and Space stay native,
 * so it needs no script. `form="latching"` draws it as interlocking latching buttons on one plinth (*Latching forms*), the selected
 * one down with its LED lit, with a `colour` for the LEDs; `flush`, or no `form`, is the look it had before, and any other string
 * is the native `form` attribute of the fieldset, as before.
 */
import { classes, strataAttributes, type StrataLevel, type StrataSize } from "../shared/markup.ts";
import { bankMarkup, latchForm, nativeForm } from "../shared/latching-forms.ts";
import type { StrataLampColour } from "../shared/lamp.ts";
import Behaviour from "./Behaviour.astro";

interface Props {
  /** Names the group, as the `<legend>`. */
  label: string;
  /** Hides the legend visually; it still names the group. */
  hideLabel?: boolean;
  options: readonly { value: string; label: string; disabled?: boolean }[];
  name: string;
  /** The selected option. */
  value?: string;
  /** The form: `latching`; `flush` is today's look; any other string is the native `form` attribute of the fieldset. */
  form?: "latching" | "flush" | (string & {});
  /** The LEDs' colour of a latching control. */
  colour?: StrataLampColour;
  size?: StrataSize;
  material?: string;
  level?: StrataLevel;
  class?: string;
  [attribute: string]: unknown;
}

const { label, hideLabel, options, name, value, form, colour, size, material, level, class: className, ...rest } = Astro.props;
const latching = latchForm(form), owner = nativeForm(form, "latching");
---
<fieldset class={classes("ug-segmented", className)} data-strata-form={latching} form={owner} {...strataAttributes({ size, material, level })} {...rest}>
  <legend class={classes("ug-segmented__legend", hideLabel && "ug-segmented__legend--hidden")}>{label}</legend>
  <div class={classes("ug-segmented__plinth", latching && "ug-bank__plinth")} data-strata-face={latching ? "raised" : undefined}>
    {options.map(option => latching
      ? <label class="ug-segmented__item"><span class="ug-push ug-latch ug-latch--bank" data-strata-colour={colour}><input class="ug-segmented__input" type="radio" name={name} value={option.value} checked={option.value === value} disabled={option.disabled} /><span class="ug-push__object ug-latch__object" aria-hidden="true">{bankMarkup.map(part => <span class={part.className} data-strata-face={part.face}></span>)}</span><span class="ug-push__cap ug-segmented__key" data-strata-face="raised">{option.label}</span></span></label>
      : (
      <label class="ug-segmented__item">
        <input class="ug-segmented__input" type="radio" name={name} value={option.value} checked={option.value === value} disabled={option.disabled} />
        <span class="ug-segmented__key" data-strata-face="raised">{option.label}</span>
      </label>
    ))}
  </div>
</fieldset>
{latching && <Behaviour />}
