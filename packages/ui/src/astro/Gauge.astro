---
/**
 * Gauge (anatomy page `gauge.md`): a native `<meter>` (role `meter`) under a round dial: a needle on a printed arc
 * (`gauge.sweep`, 240°), under glass, with a red zone below `low` and above `high` when they are given, and its legend
 * printed under the dial, rendered on the server. A Gauge shows a bounded measurement. With no script it is a native
 * meter, drawn as rendered; keeping the needle in step with a changed value comes from `attachStrata`, which it loads.
 * `class`, `style` and other attributes reach the `.ug-meter.ug-gauge` root. `unit` keeps `aria-valuetext` in step in the
 * browser; a `format` function would only apply on the server, so Astro takes `unit` alone.
 */
import Behaviour from "./Behaviour.astro";
import MeterObject from "./MeterObject.astro";
import { nextId } from "./field.ts";
import { meterModel, type MeterMark } from "../shared/meter.ts";
import { classes, strataAttributes, type StrataLevel, type StrataSize } from "../shared/markup.ts";

interface Props {
  /** The legend printed under the dial; it names the gauge. */
  label: string;
  value: number;
  min?: number;
  max?: number;
  low?: number;
  high?: number;
  optimum?: number;
  marks?: number | readonly (number | MeterMark)[];
  /** A unit for `aria-valuetext`, appended as written (" dB", "%"). */
  unit?: string;
  /** The native meter's id; generated when absent. */
  id?: string;
  size?: StrataSize;
  material?: string;
  level?: StrataLevel;
  class?: string;
  style?: string;
  [attribute: string]: unknown;
}

const { label, value, min, max, low, high, optimum, marks, unit, id, size, material, level, class: className, style, ...rest } = Astro.props;
const model = meterModel({ value, min, max, low, high, optimum, form: "dial", marks, unit });
const meterId = id ?? nextId("gauge");
---
<div class={classes("ug-meter", ...model.classes, className)} {...strataAttributes({ size, material, level })} style={style ? `${model.style} ${style}` : model.style} {...rest}>
  <div class="ug-meter__body">
    <MeterObject model={model} />
    <meter class="ug-meter__native" id={meterId} min={model.native.min} max={model.native.max} value={model.native.value} low={model.native.low} high={model.native.high} optimum={model.native.optimum}
      data-strata-unit={unit} aria-valuetext={model.valueText}>{model.valueText ?? String(model.native.value)}</meter>
  </div>
  <label class="ug-meter__label" for={meterId}>{label}</label>
</div>
<Behaviour />
