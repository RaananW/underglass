---
/**
 * Slider (anatomy page `slider.md`): a native `<input type="range">`; keys, pointer and touch are native. `form="knob"` or
 * `form="fader"` draws the same input as the Knob's or the Fader's object (the Fader's horizontal), and `form="wheel"` as a
 * thumbwheel (a ridged roller rolling in a slot on the Fader's track), with the round or the track behaviour of `attachStrata`,
 * which it loads; `class` and `style` then reach the drawn root and every other attribute the input. `flush` and no form are the
 * groove slider, and any other string is the native `form` attribute (the id of a form owner), as before.
 */
import Behaviour from "./Behaviour.astro";
import Field from "./Field.astro";
import { fieldControl } from "./field.ts";
import { sliderForm, sliderFormModel, sliderNumber, sliderOwner, type StrataSliderForm } from "../shared/slider-forms.ts";
import type { FaderMark } from "../shared/fader.ts";
import type { KnobMark } from "../shared/knob.ts";
import { classes, strataAttributes, type StrataLevel, type StrataSize } from "../shared/markup.ts";

interface Props {
  id?: string;
  label?: string;
  help?: string;
  disabled?: boolean;
  /** `knob`, `fader` or `wheel` to draw the Knob's, the Fader's or a thumbwheel's object over this input; `flush` or none for the groove slider. */
  form?: StrataSliderForm | "flush" | (string & {});
  /** A form's printed scale: a count of evenly spaced marks, or the marks' values (with labels). */
  marks?: number | readonly (number | KnobMark | FaderMark)[];
  /** A form's stepped positions, each a detent. */
  detents?: number;
  /** A knob's turn from minimum to maximum in degrees (the `knob.sweep` token, 270); a wheel's roll over the range (`wheel.sweep`, 150, at most 180). */
  sweep?: number;
  /** A fader's carriage travel in CSS px (`size.fader` by default); a wheel's drag travel (0.4 of that by default). */
  travel?: number;
  /** A form's unit for `aria-valuetext`, appended as written (" dB", "%"). */
  unit?: string;
  /** The value a form's double-click returns to; `value` by default. */
  resetValue?: number;
  size?: StrataSize;
  material?: string;
  level?: StrataLevel;
  class?: string;
  style?: string;
  [attribute: string]: unknown;
}

const { id, label, help, disabled, form, marks, detents, sweep, travel, unit, resetValue, size, material, level, class: className, style, ...rest } = Astro.props;
const field = fieldControl({ id, label, help, disabled });
const formed = sliderForm(form), owner = sliderOwner(form);
const { value, min, max, step, ...inputAttributes } = rest as Record<string, unknown>;
const low = sliderNumber(min, 0), start = sliderNumber(value, low);
const model = formed ? sliderFormModel(formed, { value: start, min: low, max: sliderNumber(max, 100), step: step !== undefined ? sliderNumber(step, 1) : undefined, marks, detents, sweep, travel, unit }) : undefined;
const knob = formed === "knob";
const part = knob ? "knob" : "fader";
const inputId = field.id || undefined;
---
<Field wrap={field.wrap} controlId={field.id} label={label} help={help}>
  {model ? (
    <div class={classes(...model.rootClass, className)} data-strata-form={formed} {...strataAttributes({ size, material, level })} style={style ? `${model.style} ${style}` : model.style}>
      {knob ? (
        <div class="ug-knob__dial">
          <span class="ug-knob__scale" aria-hidden="true">{model.marks.map(mark => <span class="ug-knob__mark" data-strata-value={String(mark.value)} style={mark.style}>{mark.text}</span>)}</span>
          <span class="ug-knob__skirt" data-strata-face="raised" aria-hidden="true"><span class="ug-knob__cap" data-strata-face="raised"><span class="ug-knob__pointer"></span></span></span>
          <input class="ug-knob__input" type="range" min={model.min} max={model.max} step={model.step} value={String(start)} data-strata-default={String(resetValue ?? start)} data-strata-unit={unit}
            aria-valuetext={model.valueText} {...field.attrs} {...inputAttributes} />
        </div>
      ) : (
        <div class="ug-fader__track">
          <span class="ug-fader__scale" aria-hidden="true">{model.marks.map(mark => <span class="ug-fader__mark" data-strata-value={String(mark.value)} style={mark.style}>{mark.text}</span>)}</span>
          <span class="ug-fader__slot" data-strata-face="groove" aria-hidden="true"></span>
          {formed === "wheel"
            ? <span class="ug-fader__carriage ug-fader__wheel" data-strata-face="raised" aria-hidden="true"><span class="ug-fader__ridges"></span></span>
            : <span class="ug-fader__carriage" data-strata-face="raised" aria-hidden="true"><span class="ug-fader__grip"></span></span>}
          <input class="ug-fader__input" type="range" min={model.min} max={model.max} step={model.step} value={String(start)} data-strata-default={String(resetValue ?? start)} data-strata-unit={unit}
            aria-valuetext={model.valueText} {...field.attrs} {...inputAttributes} />
        </div>
      )}
    </div>
    <Behaviour />
  ) : (
    <input type="range" class={classes("ug-slider", className)} style={style} data-strata-face="groove" {...strataAttributes({ size, material, level })} {...field.attrs} form={owner} value={value as string | number | undefined} min={min as string | number | undefined} max={max as string | number | undefined} step={step as string | number | undefined} {...inputAttributes} />
  )}
</Field>
