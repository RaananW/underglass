{
  "name": "@underglass/css-compiler",
  "version": "0.1.0",
  "description": "Opt-in build-time compiler that turns selected CSS animations into Underglass GPU programs, with Vite and webpack integrations.",
  "keywords": [
    "webgpu",
    "css",
    "animation",
    "vite-plugin",
    "webpack-plugin"
  ],
  "homepage": "https://github.com/RaananW/underglass/tree/main/packages/css-compiler#readme",
  "bugs": {
    "url": "https://github.com/RaananW/underglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/underglass.git",
    "directory": "packages/css-compiler"
  },
  "author": "Raanan Weber (https://github.com/RaananW)",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "import": "./src/vite.mjs"
    },
    "./webpack": {
      "types": "./src/webpack.d.ts",
      "import": "./src/webpack.mjs"
    },
    "./webpack-loader": "./src/webpack-loader.mjs",
    "./client": {
      "types": "./src/client.d.ts"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "src",
    "schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@underglass/core": "0.1.0",
    "magic-string": "1.4.3",
    "postcss": "8.5.31",
    "postcss-load-config": "6.0.1",
    "postcss-value-parser": "4.2.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
