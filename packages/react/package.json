{
  "name": "@underglass/react",
  "version": "0.1.0",
  "description": "React adapter for Underglass: GPU-presented layers over ordinary React controls and state.",
  "keywords": [
    "react",
    "webgpu",
    "html-in-canvas",
    "gpu",
    "canvas",
    "ui"
  ],
  "homepage": "https://github.com/RaananW/underglass/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/RaananW/underglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/underglass.git",
    "directory": "packages/react"
  },
  "author": "Raanan Weber (https://github.com/RaananW)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./build": {
      "types": "./dist/library/build.d.ts",
      "import": "./dist/library/build.js"
    },
    "./experimental-worker": {
      "types": "./dist/library/experimental-worker.d.ts",
      "import": "./dist/library/experimental-worker.js"
    },
    "./experimental-worker/thread": {
      "types": "./dist/library/worker-thread.d.ts",
      "import": "./dist/library/worker-thread.js"
    }
  },
  "files": [
    "dist/library/*.js",
    "dist/library/*.d.ts",
    "docs/distribution.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "prepack": "npm run build && node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@underglass/core": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
