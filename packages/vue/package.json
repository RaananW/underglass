{
  "name": "@underglass/vue",
  "version": "0.2.1",
  "description": "Vue 3 adapter for Underglass: GPU-presented layers over ordinary Vue controls and state.",
  "keywords": [
    "vue",
    "webgpu",
    "html-in-canvas",
    "gpu",
    "canvas",
    "ui"
  ],
  "homepage": "https://github.com/RaananW/underglass/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/RaananW/underglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/underglass.git",
    "directory": "packages/vue"
  },
  "author": "Raanan Weber (https://github.com/RaananW)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    }
  },
  "files": [
    "dist/library/*.js",
    "dist/library/*.d.ts",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@underglass/core": "0.2.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
