---
/**
 * Strata Astro Knob check page (`/knob/`): `[data-contract="knob.md"]` renders the anatomy page's markup example with
 * `@underglass/ui/astro`, and `main` holds live knobs `tests/browser/ui-knob-astro.test.mjs` drives with real input.
 * Server-rendered HTML; the only script is the components' own `attachStrata`.
 */
import "@underglass/ui/css";
import { Knob } from "@underglass/ui/astro";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="data:,"><title>Strata Astro Knob check</title>
</head>
<body>
  <div data-contract="knob.md" hidden><Knob label="Gain" id="gain" name="gain" min={-12} max={12} detents={5} value={0} unit=" dB" /></div>
  <main>
    <form class="ug-panel" data-strata-face="raised" aria-label="Knobs" id="knobs" style="display: flex; flex-wrap: wrap; gap: 20px">
      <Knob label="Level" id="level" name="level" min={0} max={100} value={40} unit="%" class="extra" style="margin-right: 4px" data-testid="level" />
      <Knob label="Mix" id="mix" name="mix" min={0} max={10} step={0.5} value={7} resetValue={5} marks={[0, { value: 5, label: "Half" }, 10]} />
    </form>
  </main>
</body>
</html>
