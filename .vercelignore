# Vercel uploads (CLI) and builds (Git) only what the site build needs: the workspaces, the lockfile,
# the documentation sources (without the archive), the build scripts and their policy helper.
# See docs/showcase.md#deployment.
/*
!/package.json
!/package-lock.json
!/vercel.json
!/packages
!/examples
!/docs
/docs/archive
!/scripts
/scripts/*
!/scripts/check-showcase-assets.mjs
!/scripts/assemble-site.mjs
!/scripts/release-policy.mjs
node_modules
dist
